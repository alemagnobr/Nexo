{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User preferences and meta",
      "type": "object",
      "properties": {
        "unlockedBadges": { "type": "array" },
        "wealthProfile": { "type": "string" },
        "driveLink": { "type": "string" },
        "shoppingBudget": { "type": "number" },
        "walletBalance": { "type": "number" }
      }
    },
    "Transaction": {
      "title": "Financial Transaction",
      "description": "Income or expense record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "Investment": {
      "title": "Investment Record",
      "description": "Investment details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User root document"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "User transactions list"
    },
    "/users/{userId}/investments/{investmentId}": {
      "schema": "Investment",
      "description": "User investments list"
    }
  }
}
