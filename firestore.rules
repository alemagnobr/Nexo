rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permite que os usuários leiam e gravem seus próprios dados
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Permite o acesso a qualquer subcoleção aninhada sob o documento do usuário
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
